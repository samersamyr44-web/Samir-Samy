<section
  id="products"
  class="mx-auto w-[1337px] pt-[90px] max-[376px]:w-[342px] max-[376px]:pt-[40px]"
>
  <!-- Section Title -->
  <h2
    class="font-['Lustria'] text-[36px] font-normal leading-[43.2px] tracking-[0] max-[376px]:mx-auto max-[376px]:w-[248px] max-[376px]:text-center max-[376px]:text-[24px] max-[376px]:leading-[28.8px]"
  >
    Tisso vison in the wild
  </h2>

  <!-- Products Grid -->
  <div
    class="mt-[30px] grid w-[1339px] grid-cols-3 gap-[20px] max-[376px]:mt-[20px] max-[376px]:w-[342px] max-[376px]:grid-cols-2 max-[376px]:gap-[4px]"
  >
    {% for i in (1..6) %}
      {% assign product_key = 'product_' | append: i %}
      {% assign product = section.settings[product_key] %}

      {% if product %}
        <!-- Product Card -->
        <div
          class="custom-product-card relative h-[444px] w-[433px] cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ product.handle }}"
        >
          <img
            src="{{ product.featured_image | image_url: width: 866 }}"
            alt="{{ product.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Grid",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Grid"
    }
  ]
}
{% endschema %}