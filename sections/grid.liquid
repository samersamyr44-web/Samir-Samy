<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 433px);
    column-gap: 20px;
    row-gap: 20px;
  }

  @media (max-width: 376px) {
    .products-grid {
      grid-template-columns: repeat(2, 169px);
      column-gap: 4px;
      row-gap: 4px;
    }
  }
</style>

<section
