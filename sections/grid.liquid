<section
  class="mx-auto w-[1337px] pt-[90px] max-[376px]:w-[342px] max-[376px]:pt-[40px]"
>
  <h2
    class="font-['Lustria'] text-[36px] font-normal leading-[43.2px] tracking-[0] max-[376px]:mx-auto max-[376px]:w-[248px] max-[376px]:text-center max-[376px]:text-[24px] max-[376px]:leading-[28.8px]"
  >
    Tisso vison in the wild
  </h2>

  <div class="products-grid mt-[30px] max-[376px]:mt-[20px]">
    {% for product_index in (1..6) %}
      {% assign product_key = 'product_' | append: product_index %}
      {% assign product = section.settings[product_key] %}

      {% if product != blank %}
        <div class="product-card">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.title | escape }}"
              width="433"
              height="444"
              class="h-full w-full object-cover"
            >
          {% endif %}

          <button
            type="button"
            class="product-modal-button product-modal-button--{{ product_index }}"
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-image="{{ product.featured_image | image_url: width: 1000 }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | money }}"
            data-product-description="{{ product.description | strip_html | escape }}"
            aria-label="View product {{ product.title | escape }}"
          >
            <img
              src="{{ 'open-modal.jpg' | asset_url }}"
              alt=""
              width="22"
              height="22"
            >
          </button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- ======================================== -->
<!-- Product Modal Overlay -->
<!-- ======================================== -->

<div
  id="modal-overlay"
  class="fixed inset-0 z-40 hidden bg-black/30"
></div>

<!-- ======================================== -->
<!-- Product Modal -->
<!-- ======================================== -->

<div
  id="product-modal"
  class="fixed left-1/2 top-1/2 z-50 hidden h-[447px] w-[311px] -translate-x-1/2 -translate-y-1/2 bg-white shadow-[0px_2px_4px_0px_#00000033]"
>
  <!-- Close Button -->

  <button
    id="close-modal-btn"
    type="button"
    class="absolute right-[20px] top-[20px] z-10 h-[16px] w-[16px] p-0"
    aria-label="Close product modal"
  >
    <img
      src="{{ 'close-modal.svg' | asset_url }}"
      alt=""
      aria-hidden="true"
      width="16"
      height="16"
      class="block h-full w-full"
    >
  </button>

  <!-- Product Image -->

  <img
    id="modal-product-image"
    src="{{ 'product1.jpg' | asset_url }}"
    alt=""
    width="120"
    height="140"
    class="absolute left-[20px] top-[20px] h-[140px] w-[120px] object-cover"
  >

  <!-- Product Information -->

  <div class="absolute left-[160px] top-[20px] w-[131px]">
    <h3
      id="modal-product-title"
      class="font-['Jost'] text-[16px] font-normal leading-[20.48px]"
    ></h3>

    <p
      id="modal-product-price"
      class="mt-[8px] font-['Jost'] text-[16px] font-normal leading-[20.48px]"
    ></p>

    <p
      id="modal-product-description"
      class="mt-[14px] font-['Jost'] text-[12px] font-normal leading-[15.36px]"
    ></p>
  </div>

  <!-- Color Selector -->

  <div
    id="color-selector"
    class="absolute left-[20px] top-[190px] h-[45px] w-[271px] overflow-hidden border-[0.5px] border-black"
  >
    <div
      id="color-slider"
      class="absolute left-[5px] top-[5px] h-[35px] w-[131px] bg-black transition-all duration-200"
    ></div>

    <button
      id="color-white"
      type="button"
      class="absolute left-0 top-0 h-[44px] w-[135px] p-0"
    >
      <span
        id="white-text"
        class="absolute left-[52px] top-[13px] font-['Jost'] text-[14px] font-normal leading-[17.92px] text-white"
      >
        White
      </span>

      <span
        id="first-color-indicator"
        class="absolute left-[24px] top-[16px] h-[10px] w-[10px] rounded-full border-[0.5px] border-black"
      ></span>
    </button>

    <button
      id="color-black"
      type="button"
      class="absolute left-[135px] top-0 h-[44px] w-[135px] p-0"
    >
      <span
        id="black-text"
        class="absolute left-[52px] top-[13px] font-['Jost'] text-[14px] font-normal leading-[17.92px] text-black"
      >
        Black
      </span>

      <span
        id="second-color-indicator"
        class="absolute left-[24px] top-[16px] h-[10px] w-[10px] rounded-full border-[0.5px] border-black"
      ></span>
    </button>
  </div>

  <!-- Size Selector -->

  <div
    id="size-group"
    class="absolute left-[20px] top-[250px] h-[45px] w-[271px]"
  >
    <button
      id="size-toggle"
      type="button"
      class="relative h-[45px] w-[271px] border-[0.5px] border-black bg-white p-0"
    >
      <span
        id="size-value"
        class="absolute left-0 top-[13px] w-[216px] text-center font-['Jost'] text-[14px] font-normal leading-[17.92px]"
      >
        Choose your size
      </span>

      <img
        id="size-arrow"
        src="{{ 'icon-arrow.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        width="20"
        height="20"
        class="absolute right-[12px] top-[12px] h-[20px] w-[20px] transition-transform duration-200"
      >
    </button>

    <div
      id="size-dropdown"
      class="absolute left-0 top-[45px] z-20 hidden w-[271px] border-x-[0.5px] border-b-[0.5px] border-black bg-white"
    >
      {% assign sizes = 'XS,S,M,L,XL' | split: ',' %}

      {% for size in sizes %}
        <button
          type="button"
          class="size-option block h-[35px] w-full border-b-[0.5px] border-black bg-white text-left font-['Jost'] text-[14px] font-normal leading-[17.92px] hover:bg-black hover:text-white"
          data-size="{{ size }}"
        >
          {{ size }}
        </button>
      {% endfor %}
    </div>
  </div>

  <!-- Add To Cart -->

  <button
    id="add-to-cart-btn"
    type="button"
    class="absolute left-[20px] top-[377px] z-10 h-[45px] w-[271px] border-[0.5px] border-black bg-black font-['Jost'] text-[16px] font-normal leading-[20.48px] text-white"
  >
    <span class="absolute left-[74.42px] top-[12px]">
      ADD TO CART
    </span>

    <img
      src="{{ 'icon-arrow.svg' | asset_url }}"
      alt=""
      aria-hidden="true"
      width="20"
      height="20"
      class="button-arrow modal-arrow"
    >
  </button>
</div>

{% schema %}
{
  "name": "Custom Grid",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Custom Grid"
    }
  ]
}
{% endschema %}