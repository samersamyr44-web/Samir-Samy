<!-- Modal Overlay -->
<div
  id="modal-overlay"
  class="fixed inset-0 z-40 hidden bg-black/30"
></div>

<!-- Product Modal -->
<div
  id="product-modal"
  class="fixed left-1/2 top-1/2 z-50 hidden h-[447px] w-[311px] -translate-x-1/2 -translate-y-1/2 bg-white shadow-[0px_2px_4px_0px_#00000033]"
>
  <!-- Close Modal -->
  <img
    id="close-modal-btn"
    src="{{ 'close-modal.svg' | asset_url }}"
    alt="Close"
    class="absolute left-[278.8px] top-[12.7px] h-[16px] w-[16px] cursor-pointer"
  />

  <!-- Product Image -->
  <img
    id="modal-product-image"
    src="{{ 'product1.jpg' | asset_url }}"
    alt=""
    class="absolute left-[17px] top-[36px] h-[140px] w-[120px] object-cover"
  />

  <!--Product Name-->
  <p id="modal-product-title"
  class="absolute left-[145px] w-[136px] top-[49px] font-['Jost'] text-[16px] font-light leading-[19.2px] tracking-[0] text-black">
    Orange Wide Leg
  </p>

  <!--product price-->
  <p id="modal-product-price"
  class="absolute left-[145px] top-[88px] font-['Lustria'] text-[16px] font-normal leading-[19.2px] tracking-[0] text-black">
    980,00€
  </p>

  <!-- product-description-->
