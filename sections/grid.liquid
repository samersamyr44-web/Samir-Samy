<style>
  .products-grid{
  display:grid;
grid-template-columns:repeat(3,433px);
column-gap:20px;
row-gap:20px;
}
@media (max-width:376){
.products-grid{
  grid-template-columns:repeat(2,169px);
  column-gap:4px;
}}
</style>

<section class="mx-auto w-[1337px] pt-[90px] max-[376px]:w-[342px] max-[376px]:pt-[40px]">

  <!--product section title-->
  <h2 class="font-['Lustria'] text-[36px] font-normal leading-[43.2px] tracking-[0] max-[376px]:mx-auto max-[376px]:w-[248px] max-[376px]:text-center 
    max-[376]:text-[24px] max-[376px]:leading-[28.8px]">
    Tisso vison in the wild
  </h2>

  <!-- product container-->

  <div class="products-grid mt-[30px] max-[376px]:mt-[20px]">

    <!--product1-->
    {% assign product = section.settings.product_1 %}
  {% if product != blank %}
    <div
    class="relative h-[444px] w-[433px] max-[376px]:h-[186.42px] max-[376px]:w:[169px] ">
    {% if product.featured_image %}
      <img 
      src="{{ product.featured_image  | image_url: width:1000 }}"
      alt="{{ product.title |escape }}"
      width="433"
      height="444"
      class="h-full w-full object-cover max-[376px]:w-[169] max-[376px]:h-[186.42px]">
  {% endif %}
  <button type="button"
          class="absolute left-[256.5px] top-[238px] h-[22px] w-[22px] overflow-hidden rounded-full p-0 max-[376px]:left-[101.29px] max-[376px]:top-[18px]
           max-[376px]:h-[15.714px]max-[376px]:w-[15.714px]"

           data-product-id="{{ product.id }}"
           data-product-image="{{ product.featured_image | image_url: width:1000  }}"
           data-product-title="{{ product.title | escape }}"
           data-product-price="{{ product.price |money }}"
           data-product-description="{{ product.description |strip_html | escape}}"
           aria-label="View product{{ product.title |escape }}">

    <img
      src="{{'open-modal.jpg' |asset_url }}"
      alt=""
      width="22"
      height="22"
      class="block h-full w-full object-cover">

  </button>
  </div>
  {% endif %}

