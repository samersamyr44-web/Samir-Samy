<section
  id="products"
  class="mx-auto w-[1337px] pt-[90px] max-[376px]:w-[342px] max-[376px]:pt-[40px]"
>
  <!-- Section Title -->
  <h2
    class="font-['Lustria'] text-[36px] font-normal leading-[43.2px] tracking-[0] max-[376px]:mx-auto max-[376px]:w-[248px] max-[376px]:text-center max-[376px]:text-[24px] max-[376px]:leading-[28.8px]"
  >
    Tisso vison in the wild
  </h2>

  <!-- Products -->
  <div class="mt-[30px] max-[376px]:mt-[20px]">

    <!-- Row 1 -->
    <div
      class="flex gap-[20px] max-[376px]:grid max-[376px]:grid-cols-2 max-[376px]:gap-[4px]"
    >
      <!-- Product 1 -->
      {% if section.settings.product_1 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_1.handle }}"
        >
          <img
            src="{{ section.settings.product_1.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_1.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}

      <!-- Product 2 -->
      {% if section.settings.product_2 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_2.handle }}"
        >
          <img
            src="{{ section.settings.product_2.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_2.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}

      <!-- Product 3 -->
      {% if section.settings.product_3 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_3.handle }}"
        >
          <img
            src="{{ section.settings.product_3.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_3.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}
    </div>

    <!-- Row 2 -->
    <div
      class="mt-[20px] flex gap-[20px] max-[376px]:mt-[4px] max-[376px]:grid max-[376px]:grid-cols-2 max-[376px]:gap-[4px]"
    >
      <!-- Product 4 -->
      {% if section.settings.product_4 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_4.handle }}"
        >
          <img
            src="{{ section.settings.product_4.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_4.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}

      <!-- Product 5 -->
      {% if section.settings.product_5 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_5.handle }}"
        >
          <img
            src="{{ section.settings.product_5.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_5.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}

      <!-- Product 6 -->
      {% if section.settings.product_6 %}
        <div
          class="custom-product-card relative h-[444px] w-[433px] shrink-0 cursor-pointer max-[376px]:h-[186.42px] max-[376px]:w-[169px]"
          data-product-handle="{{ section.settings.product_6.handle }}"
        >
          <img
            src="{{ section.settings.product_6.featured_image | image_url: width: 866 }}"
            alt="{{ section.settings.product_6.title | escape }}"
            width="433"
            height="444"
            class="!h-full !w-full object-cover"
          >
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Grid",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Grid"
    }
  ]
}
{% endschema %}