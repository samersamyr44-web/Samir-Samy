<section
  class="mx-auto w-[1337px] pt-[90px] max-[376px]:w-[342px] max-[376px]:pt-[40px]"
>
  <h2
    class="font-['Lustria'] text-[36px] font-normal leading-[43.2px] tracking-[0] max-[376px]:mx-auto max-[376px]:w-[248px] max-[376px]:text-center max-[376px]:text-[24px] max-[376px]:leading-[28.8px]"
  >
    Tisso vison in the wild
  </h2>

  <div class="products-grid mt-[30px] max-[376px]:mt-[20px]">
    {% for product_index in (1..6) %}
      {% assign product_key = 'product_' | append: product_index %}
      {% assign product = section.settings[product_key] %}

      {% if product != blank %}
        <div class="product-card">

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.title | escape }}"
              width="433"
              height="444"
              class="h-full w-full object-cover"
            >
          {% endif %}

          <button
            type="button"
            class="product-modal-button product-modal-button--{{ product_index }}"
            data-product-id="{{ product.id }}"
            data-product-image="{{ product.featured_image | image_url: width: 1000 }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | money }}"
            data-product-description="{{ product.description | strip_html | escape }}"
            aria-label="View product {{ product.title | escape }}"
          >
            <img
              src="{{ 'open-modal.jpg' | asset_url }}"
              alt=""
              width="22"
              height="22"
            >
          </button>

        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- Modal Overlay -->
<div
  id="modal-overlay"
  class="fixed inset-0 z-40 hidden bg-black/30"
></div>

<!-- Product Modal -->
<div
  id="product-modal"
  class="fixed left-1/2 top-1/2 z-50 hidden h-[447px] w-[311px] -translate-x-1/2 -translate-y-1/2 bg-white shadow-[0px_2px_4px_0px_#00000033]"
>
  <!-- Close Modal -->
  <img
    id="close-modal-btn"
    src="{{ 'close-modal.svg' | asset_url }}"
    alt="Close"
    class="absolute left-[278.8px] top-[12.7px] h-[16px] w-[16px] cursor-pointer"
  >

  <!-- Product Image -->
  <img
    id="modal-product-image"
    src="{{ 'product1.jpg' | asset_url }}"
    alt=""
    class="absolute left-[17px] top-[36px] h-[140px] w-[120px] object-cover"
  >

  <!-- Product Name -->
  <p
    id="modal-product-title"
    class="absolute left-[145px] top-[49px] w-[136px] font-['Jost'] text-[16px] font-light leading-[19.2px] tracking-[0] text-black"
  >
    Orange Wide Leg
  </p>

  <!-- Product Price -->
  <p
    id="modal-product-price"
    class="absolute left-[145px] top-[88px] w-[64px] font-['Lustria'] text-[16px] font-normal leading-[19.2px] tracking-[0] text-black"
  >
    980,00€
  </p>

  <!-- Product Description -->
  <p
    id="modal-product-description"
    class="absolute left-[145px] top-[119px] w-[146px] font-['Jost'] text-[14px] font-light leading-[15.4px] tracking-[-0.01em] text-black"
  >
    This one-piece swimsuit is crafted from jersey featuring an allover
    micro Monogram motif in relief.
  </p>

  <!-- Color Group -->
  <div class="absolute left-[20px] top-[186px] h-[64.477px] w-[271px]">
    <p
      class="absolute left-0 top-0 font-['Jost'] text-[14px] font-normal leading-[18.2px] tracking-[0] text-[#333333]"
    >
      Color
    </p>

    <div
      id="color-selector"
      class="absolute left-0 top-[24.04px] h-[40.441px] w-[271px] overflow-hidden border-[0.5px] border-black"
    >
      <span
        id="color-slider"
        aria-hidden="true"
        class="absolute left-[5px] top-0 z-0 h-[40px] w-[131px] bg-black transition-[left,width] duration-[300ms] ease-out"
      ></span>

      <span
        id="first-color-indicator"
        aria-hidden="true"
        class="absolute left-0 top-0 z-20 h-[40.441322px] w-[5.807143px] border-[0.5px] border-black"
      ></span>

      <span
        id="second-color-indicator"
        aria-hidden="true"
        class="absolute left-[135.5px] top-0 z-20 h-[39.6325px] w-[4.839286px] border-[0.5px] border-black bg-black"
      ></span>

      <button
        id="color-white"
        type="button"
        class="absolute left-[5px] top-0 z-10 h-[40px] w-[131px] bg-transparent"
      >
        <span
          id="white-text"
          class="absolute left-[10px] top-[11px] font-['Jost'] text-[18px] font-normal leading-[18px] tracking-[-0.02em] text-white"
        >
          White
        </span>
      </button>

      <button
        id="color-black"
        type="button"
        class="absolute left-[140px] top-0 z-10 h-[40px] w-[130px] bg-transparent"
      >
        <span
          id="black-text"
          class="absolute left-[9px] top-[11px] font-['Jost'] text-[18px] font-normal leading-[18px] tracking-[-0.02em] text-black"
        >
          Black
        </span>
      </button>
    </div>
  </div>

  <!-- Size Group -->
  <div
    id="size-group"
    class="absolute left-[20px] top-[262px] h-[64px] w-[271px]"
  >
    <p
      class="absolute left-0 top-0 font-['Jost'] text-[14px] font-normal leading-[18.2px] text-[#333333]"
    >
      Size
    </p>

    <div
      id="size-selector"
      class="absolute left-0 top-[24.35px] h-[40.44px] w-[271px] border-[0.5px] border-black"
    >
      <button
        id="size-toggle"
        type="button"
        class="absolute left-0 top-0 h-full w-full text-left"
      >
        <span
          id="size-value"
          class="absolute left-0 top-[10.65px] flex w-[216px] justify-center font-['Jost'] text-[16px] font-normal leading-[16px] tracking-[-0.02em] text-black"
        >
          Choose your size
        </span>
      </button>

      <span
        class="absolute left-[216px] top-[0.19px] h-[39.7289px] w-0 border-l-[0.5px] border-black"
        aria-hidden="true"
      ></span>

      <img
        id="size-arrow"
        src="{{ 'Vector-dropdown-before.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        class="absolute left-[238px] top-[17.65px] h-[6px] w-[12px]"
      >

      <div
        id="size-dropdown"
        class="absolute left-[-0.5px] top-[39.5px] z-20 hidden h-[99px] w-[271px] overflow-y-auto border-[1px] border-black bg-white [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {% assign sizes = 'XS,S,M,L,XL' | split: ',' %}

        {% for size in sizes %}
          <button
            type="button"
            data-size="{{ size }}"
            class="size-option flex h-[33px] w-full items-center justify-center font-['Jost'] text-[16px] font-normal leading-[19.8px] text-black hover:bg-black hover:text-white"
          >
            {{ size }}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Add To Cart -->
  <button
    type="button"
    class="absolute left-[20px] top-[377px] z-10 h-[45px] w-[271px] border-[0.5px] border-black bg-black font-['Jost'] text-[16px] font-normal leading-[20.48px] text-white"
  >
    <span class="absolute left-[74.42px] top-[12px]">
      ADD TO CART
    </span>

    <img
      src="{{ 'icon-arrow.svg' | asset_url }}"
      alt=""
      aria-hidden="true"
      width="20"
      height="20"
      class="button-arrow modal-arrow"
    >
  </button>
</div>

{% schema %}
{
  "name": "Grid",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Grid"
    }
  ]
}
{% endschema %}