<section class="relative border-b border-gray-200">
  <header
    class="relative z-30 flex h-16 w-full items-center justify-center gap-[360px] bg-[#F5F5F5] px-[50px] py-[10px] max-[376px]:h-[65px] max-[376px]:justify-start max-[376px]:gap-0 max-[376px]:bg-[#F7F7F7] max-[376px]:px-4 max-[376px]:py-[23px] max-[376px]:shadow-[0px_2px_4px_0px_#00000026]"
  >
    <!-- Mobile Menu Button -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      class="hidden max-[376px]:absolute max-[376px]:left-4 max-[376px]:top-[27.5px] max-[376px]:block"
    >
<img 
  id="menu-icon" 
  src="{{ 'open-menu.jpg' | file_url }}" 
  alt="" 
  width="18"
  height="10"
  class="h-[10px] w-[18px]" 
>
    </button>

    <!-- Logo -->
<img 
  src="{{ 'logo.svg' | file_url }}" 
  alt="TISSO VISION" 
  width="151"
  height="19"
  class="h-[19px] w-[151.44px] max-[376px]:absolute max-[376px]:left-1/2 max-[376px]:top-[23px] max-[376px]:-translate-x-1/2" 
>

    <!-- Desktop Description -->
    <p
      class="text-center font-['Jost'] text-[16px] font-normal leading-[13.42px] max-[376px]:hidden"
    >
      Find the ideal gift for your loved ones.
    </p>

    <!-- Desktop Choose Gift -->
    <a
      href="#products"
      class="group relative isolate flex h-[44px] w-[207px] shrink-0 items-center justify-center overflow-hidden bg-[#FFF544] font-['Jost'] text-[16px] font-normal uppercase leading-[20.48px] text-black max-[376px]:hidden"
    >
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 z-0 w-0 bg-black transition-[width] duration-[500ms] ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:w-full group-focus-visible:w-full"
      ></span>

      <span
        class="absolute left-[41px] top-[11.67px] z-10 h-[21px] w-[102px] text-center transition-colors duration-[500ms] group-hover:text-white group-focus-visible:text-white"
      >
        CHOOSE GIFT
      </span>

      <span
        aria-hidden="true"
        class="absolute left-[161px] top-[21.55px] z-10 w-[24px] border-t-[1.5px] border-black transition-colors duration-[500ms] group-hover:border-white group-focus-visible:border-white"
      >
        <span
          class="absolute right-0 top-[-4px] h-[8px] w-[8px] rotate-45 border-r-[1.5px] border-t-[1.5px] border-black transition-colors duration-[500ms] group-hover:border-white group-focus-visible:border-white"
        ></span>
      </span>
    </a>
  </header>

  <!-- Mobile Menu Panel -->
  <div
    id="mobile-menu"
    class="hidden absolute left-0 top-[65px] z-20 h-[124px] w-full flex-col items-center gap-[16px] bg-[#F2F2F2] px-[65.5px] py-[25px]"
  >
    <!-- Mobile Description -->
    <p
      class="h-[14px] w-[260px] text-center font-['Jost'] text-[16px] font-normal leading-[13.42px] text-black"
    >
      Find the ideal gift for your loved ones.
    </p>

    <!-- Mobile Choose Gift -->
    <a
      href="#products"
      class="group relative isolate flex h-[44px] w-[244px] shrink-0 items-center justify-center overflow-hidden bg-[#FFF544] font-['Jost'] text-[16px] font-normal uppercase leading-[20.48px] text-black"
    >
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 z-0 w-0 bg-black transition-[width] duration-[500ms] ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:w-full group-focus-visible:w-full"
      ></span>

      <span
        class="absolute left-[41px] top-[11.67px] z-10 h-[21px] w-[102px] text-center transition-colors duration-[500ms] group-hover:text-white group-focus-visible:text-white"
      >
        CHOOSE GIFT
      </span>

      <span
        aria-hidden="true"
        class="absolute left-[198px] top-[21.55px] z-10 w-[24px] border-t-[1.5px] border-black transition-colors duration-[500ms] group-hover:border-white group-focus-visible:border-white"
      >
        <span
          class="absolute right-0 top-[-4px] h-[8px] w-[8px] rotate-45 border-r-[1.5px] border-t-[1.5px] border-black transition-colors duration-[500ms] group-hover:border-white group-focus-visible:border-white"
        ></span>
      </span>
    </a>
  </div>
</section>

<!-- Hero -->
<section
  id="hero-section"
  class="relative h-[780px] w-full overflow-hidden max-[376px]:h-[421px]"
>
  <!-- Desktop Frame 1 -->
src="{{ 'Frame1.svg' | file_url }}"
width="1440"
height="390"
    alt=""
    aria-hidden="true"
    class="absolute left-0 top-0 h-[390px] w-[1440px] max-[376px]:hidden"
  >

  <!-- Mobile Frame 1 -->
<img
  src="{{ 'frame1-crop.jpg' | file_url }}"
  alt=""
  aria-hidden="true"
  width="686"
  height="264"
  class="hidden max-[376px]:absolute max-[376px]:left-0 max-[376px]:top-[157px] max-[376px]:block max-[376px]:h-[264px] max-[376px]:w-[686px]"
>
  <!-- Desktop Frame 2 -->
<img
  src="{{ 'Frame2.svg' | file_url }}"
  alt=""
  width="890"
  height="402"
  class="absolute left-[550px] top-[378px] h-[402px] w-[890px] max-[376px]:hidden"
>

  <!-- Hero Content -->
  <div
    class="absolute left-[67px] top-[425px] z-10 max-[376px]:left-0 max-[376px]:top-0 max-[376px]:h-full max-[376px]:w-full"
  >
    <!-- Title -->
    <h1
      class="font-['Jost'] text-[70px] font-medium leading-[70px] max-[376px]:absolute max-[376px]:left-1/2 max-[376px]:top-[49px] max-[376px]:w-[197px] max-[376px]:-translate-x-1/2 max-[376px]:text-center max-[376px]:text-[30px] max-[376px]:leading-[30px]"
    >
      The Gift Guide
    </h1>

    <!-- Description -->
    <p
      class="mt-[50px] w-[483px] font-['Jost'] text-[20px] font-normal leading-[28px] text-black max-[376px]:absolute max-[376px]:left-1/2 max-[376px]:top-[103px] max-[376px]:mt-0 max-[376px]:h-[42px] max-[376px]:w-[340px] max-[376px]:-translate-x-1/2 max-[376px]:text-center max-[376px]:text-[16px] max-[376px]:leading-[130%]"
    >
      Discover Joy: Your Ultimate Holiday Gift Destination.
      <span class="max-[376px]:hidden">
        Explore our curated selection and find the perfect gifts to delight
        your loved ones this holiday season.
      </span>
    </p>

    <!-- Shop Now -->
    <a
      href="#products"
      class="group relative isolate mt-[50px] block h-[50px] w-[220px] overflow-hidden bg-black font-['Jost'] text-[16px] font-normal uppercase leading-[20.48px] text-white max-[376px]:absolute max-[376px]:left-[90.78px] max-[376px]:top-[337px] max-[376px]:mt-0 max-[376px]:h-[45px] max-[376px]:w-[193px]"
    >
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 z-0 w-0 bg-[#FFF544] transition-[width] duration-[500ms] ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:w-full group-focus-visible:w-full"
      ></span>

      <span
        class="absolute left-[55.07px] top-[14.26px] z-10 h-[21px] w-[87px] text-center transition-colors duration-[500ms] group-hover:text-black group-focus-visible:text-black max-[376px]:left-[53px] max-[376px]:top-[12px]"
      >
        SHOP NOW
      </span>

      <span
        aria-hidden="true"
        class="absolute left-[171.11px] top-[24.49px] z-10 w-[25.507px] border-t-[1.5px] border-white transition-colors duration-[500ms] group-hover:border-black group-focus-visible:border-black max-[376px]:left-[148px] max-[376px]:top-[21.5px]"
      >
        <span
          class="absolute right-0 top-[-5px] h-[10px] w-[10px] rotate-45 border-r-[1.5px] border-t-[1.5px] border-white transition-colors duration-[500ms] group-hover:border-black group-focus-visible:border-black"
        ></span>
      </span>
    </a>
  </div>
</section>

<!-- Announcement -->
<div class="h-[34px] w-full bg-[#F5F5F5] px-[50px] py-[10px]">
  <p
    class="text-center font-['Jost'] text-[16px] font-normal leading-[13.42px] max-[376px]:w-[288px] max-[376px]:text-[14px]"
  >
    <span class="max-[376px]:hidden">
      SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
    </span>

    <span class="hidden max-[376px]:inline">
      SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR
    </span>
  </p>
</div>

