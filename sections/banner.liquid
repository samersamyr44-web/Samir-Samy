<section class="relative border-b border-gray-200">
   <header class="relative z-30 flex h-16 w-full items-center justify-center gap-[360px] bg-[#F5F5F5] px-[50px] py-[10px] 
    max-[376px]:h-[65px] max-[376px]:justify-start max-[376px]:gap-0 max-[376px]:bg-[#F7F7F7] max-[376px]:px-4 
    max-[376px]:py-[23px] max-[376px]:shadow-[0px_2px_4px_0px_#00000026]" > 
  <!-- Mobile Menu Toggle --> 
  <button id="menu-toggle"
     type="button"
      aria-label="Open menu"
       class="mobile-menu-toggle max-[376px]:absolute max-[376px]:left-4 max-[376px]:top-[27.5px]" >

        <img id="menu-icon"
          src="{{ 'open-menu.jpg' | asset_url }}"
            data-open-menu-url="{{ 'open-menu.jpg' | asset_url }}"
            data-close-menu-url="{{ 'close-menu.jpg' | asset_url }}"
            alt=""
            width="18"
            height="10"
            class="h-[10px] w-[18px]" >
  </button>
  <!-- Logo -->
        <img src="{{ 'logo.svg' | asset_url }}"
              alt="TISSO VISION"
              width="151"
              height="19"
              class="h-[19px] w-[151.44px] max-[376px]:absolute max-[376px]:left-1/2 max-[376px]:top-[23px] max-[376px]:-translate-x-1/2" >
        <!-- header description-->
        <p class="text-center font-['Jost'] text-[16px] font-normal leading-[13.42px] max-[376px]:hidden">Find the ideal gift for your loved ones.</p>
        <!-- choose gift button desktop-->
 <a href="#products"
   class="group relative isolate flex h-[44px] w-[207px] shrink-0 items-center justify-center overflow-hidden bg-[#FFF544] font-['Jost'] text-[16px]
    font-normal uppercase leading-[20.48px] text-black max-[376px]:hidden" >
    <span aria-hidden="true" class="absolute inset-y-0 left-0 z-0 w-0 bg-black transition-[width] duration-[500ms] ease-[cubic-bezier(0.65,0,0.35,1)]
       group-hover:w-full group-focus-visible:w-full" ></span> <span class="absolute left-[41px] top-[11.67px] z-10 h-[21px] w-[115px] 
        text-center transition-colors duration-[500ms] group-hover:text-white group-focus-visible:text-white" >
         CHOOSE GIFT 
    </span> 
      <img src="{{ 'icon-arrow.svg' | asset_url }}"
           alt=""
          aria-hidden="true"
            width="20"
            height="20"
            class="button-arrow choose-gift-arrow" >
  </a>
  </header>


    



</section>
